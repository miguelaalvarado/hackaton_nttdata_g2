{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": [
      "node"
    ],
    "module": "ESNext",
    "target": "ES2022"
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts",
    "packages/*/scripts/**/*.ts",
    "apps/api/src/**/*.ts",
    "apps/worker/src/**/*.ts"
  ]
}