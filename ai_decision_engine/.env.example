# Copia a .env (ignorado por git) y completa en TU máquina. NO subir claves reales ni pegarlas en chats.
# python3 -c "import secrets;print(secrets.token_urlsafe(32))"   # para claves de integración
NEXO_DB_PATH=data/nexo.db
NEXO_INTEGRATION_KEYS={"<clave-humana>":"human","<clave-banco-simulador>":"bank_simulator","<clave-agentes>":"agent","<clave-canal-cliente>":"customer_channel","<clave-sistema>":"system","<clave-solo-lectura>":"reader"}
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Solo desarrollo: habilita POST /v1/dev/seed
# NEXO_ENABLE_DEV_SEED=1

# --- IA generativa (Conversational Agent) ---
LLM_PROVIDER=openai
OPENAI_API_KEY=<tu-clave-openai>
OPENAI_MODEL=<modelo-disponible-para-tu-cuenta>
# OPENAI_TIMEOUT=40
# NEXO_LLM_ENABLED=0     # apaga la IA y fuerza reglas
