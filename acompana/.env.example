# Copia este archivo a .env. Nunca subas .env al repositorio.
DATABASE_URL=postgresql://acompana:acompana@localhost:5432/acompana?schema=public
JWT_SECRET=cambia-este-secreto-solo-para-demo
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Asistente: mock (por defecto, sin clave) | anthropic | bedrock
LLM_PROVIDER=mock
# ANTHROPIC_API_KEY=
# LLM_MODEL=claude-opus-5-5
# AWS_REGION=us-east-1
# BEDROCK_MODEL=anthropic.claude-opus-5-5

# Canal: simulator (demo) | meta | aws  (meta y aws se implementan en la Etapa 2)
MESSAGING_CHANNEL=simulator
