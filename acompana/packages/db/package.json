{
  "name": "@acompana/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "generate": "prisma generate",
    "migrate": "node --env-file-if-exists=../../.env ../../node_modules/prisma/build/index.js migrate deploy",
    "migrate:dev": "node --env-file-if-exists=../../.env ../../node_modules/prisma/build/index.js migrate dev",
    "seed": "tsx --env-file-if-exists=../../.env src/seed/index.ts",
    "seed:ensure": "tsx --env-file-if-exists=../../.env src/seed/ensure.ts"
  },
  "dependencies": {
    "@acompana/domain": "*",
    "@prisma/client": "6.19.3",
    "prisma": "6.19.3",
    "@acompana/llm": "*",
    "@acompana/messaging": "*",
    "pg-boss": "10.4.2"
  },
  "exports": {
    ".": "./src/index.ts",
    "./services": "./src/services/index.ts"
  }
}
