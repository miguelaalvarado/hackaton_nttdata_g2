# Copia a .env.local (local) o configura como variables del proyecto / del contenedor.
# Sin OPENROUTER_API_KEY la app funciona igual con Gestor, cliente simulado y revisión de tono por reglas.

OPENROUTER_API_KEY=

# Modelos de OpenRouter (baratos por defecto; ver https://openrouter.ai/models)
AGENT_MODEL=deepseek/deepseek-v4-flash   # Gestor
FAST_MODEL=deepseek/deepseek-v4-flash    # cliente simulado y revisión de tono

# Base de datos SQLite (libSQL). Por defecto ./data/cobranza.db
# DB_URL=file:./data/cobranza.db

# Fuerza el modo de los agentes (opcional): llm | scripted
# AGENTS=llm
